# 内核源码配置 - 使用最稳定的组合
KERNEL_SOURCE=https://github.com/LineageOS/android_kernel_motorola_sm8250
KERNEL_SOURCE_BRANCH=lineage-23.0
KERNEL_CONFIG=vendor/kona_defconfig
KERNEL_IMAGE_NAME=Image.gz
ARCH=arm64
ADD_LOCALVERSION_TO_FILENAME=false
EXTRA_CMDS:LD=ld.lld
AdditionLOCALVERSION=

# Clang 配置 - 使用经过验证的稳定版本
USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu- LLVM=1

CLANG_BRANCH=master
CLANG_VERSION=r450784d

# GCC 配置 - 使用标准AOSP GCC
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# KernelSU 配置 - 完全禁用
ENABLE_KERNELSU=false
ENABLE_susfs4ksu=false
IF_KernelSU_CONTAIN_SUSFS=false
KERNELSU_URL=tiann/KernelSU
KERNELSU_TAG=
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=
KERNELSU_LKM=false
APPLY_KSU_PATCH=false

# 内核配置 - 关键修复设置
DISABLE-LTO=true
DISABLE_CC_WERROR=true
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=false

# AnyKernel3 配置
USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# 编译缓存
ENABLE_CCACHE=true

# DTBO 镜像
NEED_DTBO=false

# Boot 镜像构建
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# 系统优化
REMOVE_UNUSED_PACKAGES=true

# 额外功能 - 全部禁用确保纯净
IMPORT_DOCKER=false
Kernel_Version=4.19
Kernel_Extra_Version=4.19
Remove_Kernel_Validation=false
Backport_path_umount=false
Backport_cred_commit_required_by_kernelsu=false
Backport_rename_strncpy_from_unsafe_user_required_by_kernelsu=false
Remove_Warning=false
Docker_LXC_Patches=false
Remove_ANDROID_PARANOID_NETWORK=false
Add_Kali_Nethunter_Patches=false

# 配置生成
Generate_Build_Config=false
Generate_Build_Config_Command=
