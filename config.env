CONFIG_ENV=config.env
KERNEL_SOURCE=https://github.com/LineageOS/android_kernel_motorola_sm8250
KERNEL_SOURCE_BRANCH=lineage-23.0
KERNEL_CONFIG=vendor/kona-perf_defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64
ADD_LOCALVERSION_TO_FILENAME=true
EXTRA_CMDS:LD=ld.lld LLVM=1 LLVM_IAS=1
AdditionLOCALVERSION=-PureLineage23

USE_CUSTOM_CLANG=false
CUSTOM_CLang_SOURCE=
CUSTOM_CLANG_BRANCH=
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

CLANG_BRANCH=android12-release
CLANG_VERSION=r416183b1

ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
USE_CUSTOM_GCC_32=false

ENABLE_KERNELSU=false
KERNELSU_TAG=
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

DISABLE-LTO=false
DISABLE_CC_WERROR=true
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true
APPLY_KSU_PATCH=false
REMOVE_UNUSED_PACKAGES=true

USE_CUSTOM_ANYKERNEL3=false

ENABLE_CCACHE=true

NEED_DTBO=false

BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

Generate_Build_Config=false
Generate_Build_Config_Command:
