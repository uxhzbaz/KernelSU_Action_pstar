CONFIG_ENV="config.env

# 修改为你的内核仓库地址
KERNEL_SOURCE=https://github.com/LineageOS/android_kernel_motorola_sm8250
# 修改为你的内核分支，根据你的要求是 lineage-22.2
KERNEL_SOURCE_BRANCH=lineage-22.2
# 内核配置文件名。这个名字虽然现在源码里没有，但是会通过下面的Generate_Build_Config命令生成
KERNEL_CONFIG=vendor/lineageos_pstar_defconfig
# 最终生成的内核二进制文件名，对于sm8250平台通常是 Image
KERNEL_IMAGE_NAME=Image
# 内核架构，sm8250是arm64
ARCH=arm64

# --- 编译器配置 (Clang) ---
# 使用 AOSP 官方 Clang
USE_CUSTOM_CLANG=false
# AOSP Clang 的上游分支
CLANG_BRANCH=master-kernel-build-2022
# AOSP Clang 的具体版本号
CLANG_VERSION=r487747c

# --- 编译器配置 (GCC) ---
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true

# --- KernelSU 相关配置 ---
ENABLE_KERNELSU=false
# 以下所有 KernelSU 相关选项都不会生效，保持默认或留空即可
KERNELSU_TAG=
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# --- 内核编译微调 ---
# LTO (链接时优化) 保持开启，可以优化内核性能
DISABLE-LTO=false
# 将编译警告视为错误，建议关闭(true)，避免因为一些不影响使用的警告导致编译失败
DISABLE_CC_WERROR=true
# 由于我们禁用了KernelSU，所以不需要自动添加Kprobes配置
ADD_KPROBES_CONFIG=false
# 自动添加OverlayFS配置，这是一个有用的功能，建议开启
ADD_OVERLAYFS_CONFIG=true
# 是否移除无用的软件包以节省空间，建议开启
REMOVE_UNUSED_PACKAGES=true
# 使用默认的 AnyKernel3
USE_CUSTOM_ANYKERNEL3=false
ENABLE_CCACHE=true

# --- 编译 boot.img ---
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=
Generate_Build_Config=true
# 这条命令是核心，它将多个配置文件片段合并成一个完整的内核配置文件
Generate_Build_Config_Command:cat arch/arm64/configs/vendor/kona-perf_defconfig arch/arm64/configs/vendor/ext_config/moto-kona.config arch/arm64/configs/vendor/ext_config/pstar-default.config arch/arm64/configs/vendor/debugfs.config >> arch/arm64/configs/vendor/lineageos_pstar_defconfig
